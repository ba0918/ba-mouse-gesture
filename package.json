{
  "name": "ba-mouse-gesture",
  "version": "1.0.0",
  "description": "Mouse Gesture Tool for Chrome - A secure and simple mouse gesture extension",
  "main": "manifest.json",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts,.html",
    "lint:fix": "eslint . --ext .js,.ts,.html --fix",
    "format": "prettier --write \"**/*.{js,ts,svelte,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,ts,svelte,json,css,html}\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.js --prod",
    "build:dev": "node scripts/build.js",
    "build:watch": "node scripts/build.js --watch",
    "prepare": "husky"
  },
  "keywords": [
    "chrome-extension",
    "mouse-gesture",
    "browser-extension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "esbuild": "^0.25.8",
    "esbuild-svelte": "^0.9.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-svelte": "^3.11.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.1.2",
    "playwright": "^1.64.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-eslint-parser": "^1.3.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "content_scripts/**/*.{js,ts}",
      "background/**/*.{js,ts}",
      "popup/**/*.{js,ts}",
      "!**/*.test.{js,ts}",
      "!**/node_modules/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.{js,ts}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backup/"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/tests/__mocks__/styleMock.js",
      "\\.svelte$": "<rootDir>/tests/__mocks__/svelteMock.js",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@application/(.*)$": "<rootDir>/src/application/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@presentation/(.*)$": "<rootDir>/src/presentation/$1"
    },
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.svelte$": "<rootDir>/tests/__mocks__/svelteMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(svelte|@sveltejs)/)"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "svelte"
    ]
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write",
      "jest --findRelatedTests --passWithNoTests"
    ],
    "*.svelte": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.37.1"
  }
}
