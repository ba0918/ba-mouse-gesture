{
  "manifest_version": 3,
  "name": "Mouse Gesture Tool",
  "version": "1.0.0",
  "description": "Simple mouse gesture tool for Chrome",
  
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  
  "background": {
    "service_worker": "background/background-simple.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_scripts/gesture-simple.js"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_title": "Mouse Gesture Tool"
  },
  
  "options_ui": {
    "page": "popup/options.html",
    "open_in_tab": false
  }
}